{
  "mcpServers": {
    "playwright": {
      "command": "bash",
      "args": [
        "tools/playwright-mcp.sh",
        "-y",
        "@playwright/mcp@0.0.83",
        "--headless",
        "--browser",
        "chromium",
        "--isolated",
        "--viewport-size",
        "1280,800",
        "--output-dir",
        "data/receipts"
      ],
      "description": "A real headless Chromium browser driven by Playwright",
      "exposure": "deferred",
      "toolExposure": {
        "browser_run_code_unsafe": "hidden",
        "browser_file_upload": "hidden",
        "browser_drop": "hidden"
      }
    }
  },
  "autoEnableCodemode": false
}
