{
  "name": "@mihaiiova/toad",
  "version": "0.4.0",
  "description": "Toad: a testing agent your coding agent can call. Tests web apps in a real browser and CLIs in a container, and returns a verdict with receipts.",
  "type": "module",
  "bin": {
    "toad": "mcp/cli.mjs"
  },
  "files": [
    "mcp/*.mjs",
    "mcp/ui.html",
    "agent/run",
    "agent/.gitignore",
    "agent/.pi/system.yaml",
    "agent/.pi/settings.json",
    "agent/.pi/mcp.json",
    "agent/.pi/APPEND_SYSTEM.md",
    "agent/.pi/CAPABILITIES.md",
    "agent/.pi/agents/",
    "agent/.pi/skills/",
    "agent/tools/*.mjs",
    "!agent/tools/*.test.mjs",
    "agent/data/knowledge/.gitkeep",
    "skills/",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test mcp/test/*.test.mjs agent/tools/*.test.mjs",
    "install:local": "node scripts/install-local.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mihaiiova/toad.git"
  },
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "yaml": "2.8.3",
    "zod": "4.6.6"
  }
}
